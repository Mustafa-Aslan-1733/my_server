SERVER_PORT=8080

# CI sets these for production Compose deployments. For a manual production
# Compose run, set SPRING_DATASOURCE_URL to the external or host PostgreSQL
# address the container can reach, not necessarily localhost.
BACKEND_IMAGE=registry.example.com/group/project/server:latest
# Keep the loopback prefix: without it Docker publishes the API on 0.0.0.0:8080, where it
# answers plain HTTP from the internet and bypasses nginx, TLS and the edge access log.
BACKEND_PUBLISHED_PORT=127.0.0.1:8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_FLYWAY_ENABLED=true
# true only for the first deployment against a database that predates Flyway. Every
# deployed environment is past that point, so CI writes false: a database that has a
# schema but no flyway_schema_history should stop the deploy rather than be stamped
# as version 1 and carried on with.
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
# Exact browser origins allowed by CORS; wildcards are rejected at startup. This is only for
# callers that are NOT same-origin -- the deployed panel is served from the same host as this
# API, so its calls never reach the check. CI deploys https://ratemyprofessor.dev here.
ADMIN_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ADMIN_BOOTSTRAP_EMAILS=admin@student.kit.edu
# Administrators that may also moderate other administrator accounts. Must already
# be administrators; listing an address here is not what makes one.
ADMIN_SUPERUSER_EMAILS=admin@student.kit.edu
AUTH_RATE_LIMIT_HMAC_KEY=replace-with-at-least-32-random-characters
AUTH_OTP_TTL=PT5M
AUTH_ADMIN_SESSION_TTL=P1D
AUTH_APP_SESSION_TTL=P365D
AUTH_RATE_LIMIT_WINDOW=PT15M
AUTH_RATE_LIMIT_REQUEST_EMAIL=3
AUTH_RATE_LIMIT_REQUEST_IP=20
AUTH_RATE_LIMIT_LOGIN_EMAIL=10
AUTH_RATE_LIMIT_LOGIN_IP=30

SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=mailer@example.com
SPRING_MAIL_PASSWORD=change-me
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS=true
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=RateMyProfApp

IPINFO_TOKEN=
GEOAPIFY_API_KEY=

# How long an administrative field edit stays reversible from its audit entry.
AUDIT_REVERT_WINDOW=P7D

# GitLab issue creation for bug reports. Leave any of the three empty to disable it:
# the endpoint then answers 503 and /system/status reports gitlabEnabled=false.
# The token is used only as a backend request header and is never returned by the API.
GITLAB_BASE_URL=
GITLAB_PROJECT_ID=
GITLAB_TOKEN=
GITLAB_TIMEOUT=PT10S
